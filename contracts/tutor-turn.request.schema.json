{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "runID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "stateRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "context": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "focus": {
          "type": "object",
          "properties": {
            "articleID": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "snapshotID": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "blockID": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "sentenceID": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            },
            "rangeUTF16": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "location": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "length": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "location",
                    "length"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "articleID",
            "snapshotID",
            "blockID"
          ],
          "additionalProperties": false
        },
        "passages": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceRef": {
                "type": "object",
                "properties": {
                  "articleID": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "snapshotID": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "blockID": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "sentenceID": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "rangeUTF16": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "location": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "length": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "location",
                          "length"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "articleID",
                  "snapshotID",
                  "blockID"
                ],
                "additionalProperties": false
              },
              "blockText": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24000
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            },
            "required": [
              "sourceRef",
              "blockText",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "explanationSeen": {
          "type": "boolean"
        },
        "hintSeen": {
          "type": "boolean"
        },
        "inputModality": {
          "type": "string",
          "enum": [
            "text",
            "voice"
          ]
        },
        "presentation": {
          "type": "string",
          "enum": [
            "reading",
            "listening",
            "both"
          ]
        },
        "recentTurns": {
          "default": [],
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "role",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "focus",
        "passages",
        "explanationSeen",
        "hintSeen",
        "inputModality",
        "presentation"
      ],
      "additionalProperties": false
    },
    "learnerTurn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "task": {
      "type": "string",
      "enum": [
        "tutor",
        "explain",
        "assess",
        "read_aloud"
      ]
    },
    "practice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 10,
          "maxLength": 160,
          "format": "starts_with",
          "pattern": "^practice:.*"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "label": {
          "type": "string",
          "const": "generated_practice"
        },
        "language": {
          "default": "en",
          "type": "string",
          "const": "en"
        }
      },
      "required": [
        "id",
        "text",
        "label"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "requestID",
    "runID",
    "stateRevision",
    "context",
    "learnerTurn",
    "task"
  ],
  "additionalProperties": false,
  "$comment": "Generated from server/src/schemas.ts. Runtime also validates UTF-16 boundaries, source text equality, snapshot identity, reply source allowlist and request/revision equality."
}
