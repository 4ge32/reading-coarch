            "blockID": {
              "type": "string"
            },
            "sentenceID": {
              "type": [
                "string",
                "null"
              ]
            },
            "rangeUTF16": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "location": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "length": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "location",
                    "length"
                  ]
                }
              ]
            }
          },
          "required": [
            "articleID",
            "snapshotID",
            "blockID",
            "sentenceID",
            "rangeUTF16"
          ]
        }
      },
      "required": [
        "runID",
        "stateRevision",
        "sourceRef"
      ]
    }
  },
