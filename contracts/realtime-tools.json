  {
    "type": "function",
    "name": "get_source_context",
    "description": "Get saved original context; no URL access.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runID": {
          "type": "string"
        },
        "stateRevision": {
          "type": "integer",
          "minimum": 0
        },
