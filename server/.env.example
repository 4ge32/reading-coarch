# Copy to .env, fill values locally, and never commit that file.
# Generate a high-entropy access token, e.g. openssl rand -hex 32.
APP_ACCESS_TOKEN=
PROVIDER_MODE=live
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
PORT=8787
HOST=127.0.0.1
SESSION_DURATION_SECONDS=900
UPSTREAM_TIMEOUT_MS=30000
# Remote devices require HTTPS. Either terminate TLS at an authenticated private
# reverse proxy and keep HOST=127.0.0.1, or supply both files below.
# TLS_CERT_FILE=/path/to/fullchain.pem
# TLS_KEY_FILE=/path/to/private-key.pem
# LISTEN_PUBLIC=false
